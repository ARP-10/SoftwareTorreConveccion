/* ============================================================
   ESTILO GLOBAL - LABORATORIO DIKOIN
   ============================================================ */

/* === FONDO GENERAL === */
QWidget {
    background-color: #ecf1fd;
    color: #000000;
    font-family: "Segoe UI";
    font-size: 11pt;
}

/* === TARJETAS (CARD) === */
QWidget#card {
    background: transparent;   /* blanco para que la sombra contraste */
    border-radius: 20px;
    padding: 14px;         /* más espacio para que la sombra se vea */
}




/* ============================================================
   QGROUPBOX (contenedor interno con fondo blanco)
   ============================================================ */

QGroupBox {
    background-color: #FFFFFF;
    border-radius: 20px;
    border: none;
    font: 600 14pt "Segoe UI";
    margin: 0px 4px; 
    padding: 18px 18px 18px 18px;
}

/* Mantiene fondo interno blanco en cualquier widget dentro del GroupBox */
QGroupBox QWidget {
    background-color: #FFFFFF;
}

/* TÍTULOS DE QGROUPBOX */
QGroupBox::title {
    subcontrol-position: top left;
    margin-top: 10px;
    margin-left: 20px;
    color: #0077b6;
    font: 600 14pt "Segoe UI";
    padding-left: 40px;
    background-repeat: no-repeat;
    background-position: left center;
    padding-top: 10px;
    padding-bottom: 10px;
    min-height: 32px;
}

/* ============================================================
   CONTROL DEL EQUIPO
   ============================================================ */

QGroupBox#group_control {
    padding-top: 60px;
    margin-bottom: 10px;
}

QGroupBox#group_control::title {
    color: #0077b6;
    font: 700 14pt "Segoe UI";
    background-image: url("icons/control.png");
    padding-left: 50px;
}
/* ============================================================
   GRÁFICA
   ============================================================ */

QGroupBox#group_grafica {
    padding-top: 60px;
}

QGroupBox#group_grafica::title {
    color: #0077b6;
    font: 700 14pt "Segoe UI";
    background-image: url("icons/graph.png");
    padding-left: 50px; 
}

/* ============================================================
   RESULTADOS
   ============================================================ */

QGroupBox#group_tabla {
    padding-top: 60px;
    margin: 4px 8px;
}

QGroupBox#group_tabla::title {
    color: #0077b6;
    font: 700 14pt "Segoe UI";
    background-image: url("icons/practice.png");
    padding-left: 50px;
}

/* ============================================================
   BLOQUE LECTURAS EN TIEMPO REAL
   ============================================================ */

QGroupBox#group_lecturas {
    background-color: #0077b6;
    border-radius: 20px;
    padding-top: 70px;
    margin-bottom: 10px;
}

QGroupBox#group_lecturas::title {
    color: #ffffff;
    background-image: url("icons/measures.png");
    padding-left: 50px;
}

QGroupBox#group_lecturas QLabel {
    background: transparent;
    color: #FFFFFF;
    font-size: 11pt;
    font-weight: 500;
}

/* ============================================================
   PUSH BUTTONS
   ============================================================ */

QPushButton {
    background: #0077b6;
    color: #FFFFFF;
    border: none;
    border-radius: 14px;
    padding: 8px 16px;
    font-weight: 600;
    font-size: 11pt;
}

QPushButton:disabled {
    background-color: #4D4D4D;
    color: #CCCCCC;   /* Texto gris claro para contraste */
    border: 1px solid #3A3A3A;
}

QPushButton:hover {
    background: #0096c7;
}

QPushButton:pressed {
    background: #005f87;
}

/* ============================================================
   BOTÓN DE IDIOMA
   ============================================================ */

QToolButton#btn_language {
    border-radius: 14px;
    padding: 6px 14px;
    font-weight: 600;
    font-size: 11pt;
    background-color: transparent; 
    color: #0077b6;                 
    border: 2px solid #0077b6;     
    padding: 4px 12px;    
}

QToolButton#btn_language:hover {
    background-color: rgba(0, 119, 182, 0.10);  
    border-color: #0096c7;                     
    color: #0096c7;    
}

QToolButton#btn_language:pressed {
    background-color: rgba(0, 119, 182, 0.10);
    border: 2px solid #005f87;
    color: #005f87;
}

/* Menú */
QMenu {
    background-color: #FFFFFF;
    border: 1px solid #C9D6E8;
    border-radius: 8px;
    padding: 4px;
}

QMenu::item {
    padding: 6px 14px;
    font-size: 10.5pt;
}

QMenu::item:selected {
    background-color: #E0EEFF;
    color: #0078D7;
}

/* ============================================================
   TABLA
   ============================================================ */

QTableWidget {
    background-color: #FFFFFF;
    border-radius: 14px;
    border: none;
    gridline-color: #E0E6F0;
    alternate-background-color: #F3F7FB;
    selection-background-color: #E0F0FF;
    font-size: 10pt;
}

QHeaderView::section {
    background: #0077b6;
    color: #FFFFFF;
    font: 600 10.5pt "Segoe UI";
    padding: 8px 6px;
    border: none;
}

QHeaderView::section:first {
    border-top-left-radius: 12px;
}

QHeaderView::section:last {
    border-top-right-radius: 12px;
}


/* === QSLIDER === */
QSlider::groove:vertical {
    width: 40px;
    border-radius: 10px;
    margin: 10px 0;
    background: qlineargradient(
        x1:0, y1:1, x2:0, y2:0,
        stop:0 #A5D8FF,
        stop:1 #0078D7
    );
}

QSlider::handle:vertical {
    background: #FFFFFF;
    border: 2px solid #0078D7;
    height: 22px;
    margin: -4px -14px;
    border-radius: 10px;
}



/* === SCROLLBAR MODERNO CON PUNTAS REDONDEADAS VISIBLES === */

QScrollBar:vertical {
    background: #edf2ff;          /* azul muy claro, integrado con fondo */
    border: none;
    width: 14px;
    margin: 6px 4px 6px 0;
    border-radius: 7px;           /* curva el canal también */
}

/* Handle con efecto visual redondeado */
QScrollBar::handle:vertical {
    background: qlineargradient(
        x1:0, y1:0, x2:0, y2:1,
        stop:0 #4EA3F7,
        stop:1 #0078D7
    );
    border-radius: 7px;
    min-height: 30px;
    margin: 3px 2px 3px 2px;      /* 🔹 deja espacio para que se vean las puntas */
    border: 1px solid rgba(0,0,0,0.08);
}

/* Hover */
QScrollBar::handle:vertical:hover {
    background: qlineargradient(
        x1:0, y1:0, x2:0, y2:1,
        stop:0 #5CB0FF,
        stop:1 #2188E8
    );
}

/* Quita las flechas */
QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    background: transparent;
    border: none;
    height: 0;
}

/* Espacios vacíos transparentes */
QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
    background: transparent;
}

/* Scrollbar horizontal */
QScrollBar:horizontal {
    background: #edf2ff;
    border: none;
    height: 14px;
    margin: 0 6px 6px 6px;
    border-radius: 7px;
}

QScrollBar::handle:horizontal {
    background: qlineargradient(
        x1:0, y1:0, x2:1, y2:1,
        stop:0 #4EA3F7,
        stop:1 #0078D7
    );
    border-radius: 7px;
    min-width: 30px;
    margin: 3px 2px;
    border: 1px solid rgba(0,0,0,0.08);
}

QScrollBar::handle:horizontal:hover {
    background: qlineargradient(
        x1:0, y1:0, x2:1, y2:1,
        stop:0 #5CB0FF,
        stop:1 #2188E8
    );
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    background: transparent;
    border: none;
    width: 0;
}

QScrollBar::add-page:horizontal,
QScrollBar::sub-page:horizontal {
    background: transparent;
}

